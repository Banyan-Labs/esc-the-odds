rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Media uploaded by Payload CMS (stored under /media/)
    match /media/{allPaths=**} {
      // Anyone can view uploaded media (images on the public site)
      allow read;

      // Only authenticated admin users can upload/modify/delete
      allow write: if request.auth != null;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
