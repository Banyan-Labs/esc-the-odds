{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ],
    "redirects": [
      { "source": "/courses", "destination": "/programs", "type": 301 },
      { "source": "/documentary", "destination": "/film", "type": 301 },
      { "source": "/partner", "destination": "/organizations", "type": 301 },
      { "source": "/support", "destination": "/organizations", "type": 301 },
      { "source": "/programs/live-cohort", "destination": "/programs#live-cohort", "type": 301 },
      { "source": "/programs/self-paced", "destination": "/programs#self-paced", "type": 301 }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}

